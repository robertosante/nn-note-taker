{
  "manifest_version": 3,
  "name": "Note Taker — Meet Captions",
  "version": "0.5.0",
  "description": "Capture Google Meet captions and save them locally as Obsidian-ready Markdown.",
  "key": "",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "https://meet.google.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": [
        "content/settings-model.js",
        "content/caption-model.js",
        "content/content.js"
      ],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Show or hide Note Taker"
  }
}
